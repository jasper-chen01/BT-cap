# Prepare first: python scripts/prepare_reasoning_data.py --source . --destination data/reasoning
EPHYS_RAG_DATA_DIR=data/reasoning
EPHYS_RAG_RUNS_DIR=data/reasoning/runs/portal

# DATA_DIR remains the agent's legacy fallback when EPHYS_RAG_DATA_DIR is unset.
# Optional ranker and embedding overrides (defaults follow EPHYS_RAG_DATA_DIR):
# RANKER_DIR=data/reasoning/ranker
# ARMS_GENE_RANKS_CSV=data/reasoning/ranker/arms_gene_ranks.csv
# TABLES_SCORES_CSV=data/reasoning/ranker/tables/genesets_scores.csv
# TABLES_SCETM_SCORES_CSV=data/reasoning/ranker/tables_scetm/genesets_scores.csv
# SCETM_ONLY_SCORES_CSV=data/reasoning/ranker/scetm_only/genesets_scores.csv
# SCETM_GENE_EMBEDDINGS_CSV=data/reasoning/gene_embeddings/scetm_gene_embeddings_d32.csv
