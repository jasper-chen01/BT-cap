# Data folder containing cellchat_ephys_plus_celltype/ and the DEG/count folders.
DATA_DIR=

# Provider selection: ollama, mock, medgemma, gemini, none, or auto.
LLM_PROVIDER=medgemma

# Free local MedGemma through Ollama (Week 3).
# Use http://127.0.0.1:11435/v1 when following the CPU-only laptop setup.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=medgemma:4b-it-q4_K_M
OLLAMA_MAX_OUTPUT_TOKENS=120
OLLAMA_TEMPERATURE=0.2

# Vertex AI project and region.
GOOGLE_CLOUD_PROJECT=elec-594-bt-cap
GOOGLE_CLOUD_LOCATION=us-central1

# Optional local Application Default Credentials file. Do not commit its value.
GOOGLE_APPLICATION_CREDENTIALS=

# Existing, approved MedGemma Vertex endpoint. This project does not deploy one.
MEDGEMMA_ENDPOINT_ID=
MEDGEMMA_ENDPOINT_LOCATION=us-central1
MEDGEMMA_USE_DEDICATED_ENDPOINT=true
MEDGEMMA_MODEL_NAME=medgemma-instruction-tuned
MEDGEMMA_MAX_OUTPUT_TOKENS=1200

# Vertex Gemini comparison model.
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1200
